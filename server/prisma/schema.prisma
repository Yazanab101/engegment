generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  AR
  HE
  EN
}

enum RsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

enum InvitationStatus {
  CREATED
  OPENED
  RESPONDED
}

enum InvitationEventType {
  INVITATION_OPENED
  RSVP_ATTENDING
  RSVP_NOT_ATTENDING
  RSVP_UPDATED
  LOCATION_CLICKED
  CALENDAR_CLICKED
}

enum GuestTag {
  FAMILY
  FRIENDS
  WORK
  BRIDE_FAMILY
  GROOM_FAMILY
  VIP
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id                    String    @id @default(cuid())
  slug                  String    @unique @default("current")
  title                 String
  titleAr               String?
  titleHe               String?
  brideName             String
  groomName             String
  eventDate             DateTime
  eventStartTime        String
  venueName             String
  venueNameAr           String?
  venueNameHe           String?
  venueAddress          String
  venueAddressAr        String?
  venueAddressHe        String?
  googleMapsUrl         String?
  wazeUrl               String?
  latitude              Float?
  longitude             Float?
  rsvpDeadline          DateTime?
  contactPhone          String?
  whatsappPhone         String?
  dressCode             String?
  dressCodeAr           String?
  dressCodeHe           String?
  parkingInfo           String?
  parkingInfoAr         String?
  parkingInfoHe         String?
  additionalInfo        String?
  additionalInfoAr      String?
  additionalInfoHe      String?
  showTableAssignments  Boolean   @default(false)
  introEn               String?
  introAr               String?
  introHe               String?
  footerEn              String?
  footerAr              String?
  footerHe              String?
  taglineEn             String?
  taglineAr             String?
  taglineHe             String?
  joinUsMessageEn       String?
  joinUsMessageAr       String?
  joinUsMessageHe       String?
  inviteLeadEn          String?
  inviteLeadAr          String?
  inviteLeadHe          String?
  celebrationNoteEn     String?
  celebrationNoteAr     String?
  celebrationNoteHe     String?
  ticketHeadingEn       String?
  ticketHeadingAr       String?
  ticketHeadingHe       String?
  imageCoupleColor      String?
  imageCoupleBw         String?
  uploadsOpen           Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  guests                Guest[]
  memoryGuests          MemoryGuest[]
  memorySessions        MemoryUploadSession[]
  memoryMedia           MemoryMedia[]
  memoryMessages        MemoryMessage[]
  stories               EventStory[]
}

model Guest {
  id                String           @id @default(cuid())
  eventId           String
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName          String
  titleKey          String?
  includeFamily     Boolean          @default(false)
  familySuffixKey   String?
  phoneNumber       String?
  email             String?
  language          Language         @default(AR)
  inviteToken       String           @unique
  isActive          Boolean          @default(true)
  inviteSent        Boolean          @default(false)
  inviteSentAt      DateTime?
  maxGuestsAllowed  Int              @default(50)
  invitationStatus  InvitationStatus @default(CREATED)
  firstOpenedAt     DateTime?
  lastOpenedAt      DateTime?
  openCount         Int              @default(0)
  notes             String?
  tags              GuestTag[]       @default([])
  tableNumber       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rsvp              Rsvp?
  events            InvitationEvent[]

  @@index([eventId])
  @@index([language])
  @@index([invitationStatus])
  @@index([fullName])
  @@index([phoneNumber])
  @@index([email])
}

model Rsvp {
  id          String     @id @default(cuid())
  guestId     String     @unique
  guest       Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status      RsvpStatus @default(PENDING)
  guestCount  Int        @default(0)
  message     String?
  setByAdmin  Boolean    @default(false)
  submittedAt DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
}

model InvitationEvent {
  id        String              @id @default(cuid())
  guestId   String
  guest     Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  type      InvitationEventType
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([guestId, type, createdAt])
  @@index([createdAt])
}

model MemoryGuest {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  displayName String
  deviceToken String   @unique
  tableLabel  String?
  phoneLast4  String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  sessions    MemoryUploadSession[]
  media       MemoryMedia[]
  messages    MemoryMessage[]
  storyViews  StoryView[]

  @@index([eventId, displayName])
  @@index([eventId, lastSeenAt])
}

model MemoryUploadSession {
  id         String   @id @default(uuid())
  eventId    String
  guestId    String
  tableLabel String?
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      MemoryGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  media      MemoryMedia[]

  @@index([eventId, guestId])
}

model MemoryMedia {
  id                 String    @id @default(uuid())
  eventId            String
  guestId            String
  uploadSessionId    String
  clientUploadId     String    @unique
  storageProvider    String    @default("r2")
  objectKey          String    @unique
  thumbnailObjectKey String?
  originalFilename   String
  mimeType           String
  fileSize           Int
  mediaType          String
  width              Int?
  height             Int?
  duration           Float?
  caption            String?
  status             String    @default("pending")
  isFavorite         Boolean   @default(false)
  isHidden           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  confirmedAt        DateTime?
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest              MemoryGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  session            MemoryUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, guestId, createdAt])
  @@index([eventId, mediaType, createdAt])
  @@index([eventId, isFavorite, createdAt])
  @@index([uploadSessionId])
}

model MemoryMessage {
  id         String   @id @default(uuid())
  eventId    String
  guestId    String
  message    String
  isFavorite Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      MemoryGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, guestId, createdAt])
}

model EventStory {
  id                 String      @id @default(uuid())
  eventId            String
  mediaType          String
  objectKey          String      @unique
  thumbnailObjectKey String?
  mimeType           String?
  fileSize           Int         @default(0)
  duration           Float?
  sortOrder          Int         @default(0)
  isActive           Boolean     @default(false)
  status             String      @default("pending")
  startsAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  createdBy          String?
  event              Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  views              StoryView[]

  @@index([eventId, sortOrder, createdAt])
  @@index([eventId, isActive, status])
}

model StoryView {
  id       String       @id @default(uuid())
  storyId  String
  guestId  String?
  deviceId String?
  viewedAt DateTime     @default(now())
  story    EventStory   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  guest    MemoryGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([storyId])
}
