{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://141.136.44.242:4010/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://141.136.44.242:4010/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|assets/|audio/|og-image\\.jpg|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
